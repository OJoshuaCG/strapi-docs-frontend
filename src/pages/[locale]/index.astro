---
import DocsLayout from '@/layouts/DocsLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import CategoryCard from '@/components/ui/CategoryCard.astro';
import SiteLogo from '@/components/ui/SiteLogo.astro';
import { getSpaceSettings, getSections, getCategoriesWithArticles } from '@/lib/strapi/client';
import { isValidLocale, appConfig } from '@/lib/utils/config';
import { getHero } from '@/lib/utils/custom-config';
import { firstIconName } from '@/lib/utils/icons';
import { getUi } from '@/lib/i18n/ui';

const { locale } = Astro.params;

if (!locale || !isValidLocale(locale)) {
  return Astro.redirect(`/${appConfig.defaultLocale}`, 302);
}

// Los enlaces viejos `?section=slug` llevan a la sección dentro de la portada.
const legacySection = Astro.url.searchParams.get('section');
if (legacySection) {
  return Astro.redirect(`/${locale}#${encodeURIComponent(legacySection)}`, 301);
}

let data;
try {
  data = await Promise.all([
    getSpaceSettings(),
    getSections(locale),
    getCategoriesWithArticles(locale),
  ]);
} catch (err) {
  console.error('[portal] Failed to load home data:', err);
  return new Response(null, { status: 500 });
}
const [settings, sections, categories] = data;

const ui = getUi(locale);
const hero = getHero(settings, locale);

// Solo secciones y categorías con artículos: una tarjeta sin artículos no tendría a dónde llevar.
const groups = sections
  .map((section) => {
    const cats = categories
      .filter((cat) => cat.documentation_section?.slug === section.slug && cat.articles.length > 0)
      // La tarjeta solo lleva el icono propio de la categoría: heredar el de la sección repetía el mismo en todas.
      .map((cat) => ({ ...cat, iconName: firstIconName(cat.icon), firstSlug: cat.articles[0]?.slug ?? '' }));
    return { section, cats, iconName: firstIconName(section.icon) };
  })
  .filter((group) => group.cats.length > 0);

const siteName = settings?.siteName ?? 'Docs';

/** Tarjetas visibles por sección; las demás quedan tras «+ N categorías más». */
const HOME_MAX = 4;
---

<DocsLayout
  title={siteName}
  description={settings?.siteDescription ?? undefined}
  settings={settings}
  sections={sections}
  sidebarCategories={[]}
  locale={locale}
  supportedLocales={appConfig.supportedLocales}
  withSidebar={false}
>
  <!-- Portada «Acento de marca»: brillo suave del color de marca detrás del título, sin bordes.
       Sin índice de secciones arriba: con muchas secciones se amontonaba y repetía lo de abajo. -->
  {groups.length > 0 && (
    <section slot="hero" class="home-hero relative" style="padding: 4.5rem var(--content-padding-x, 1.5rem) 3rem;">
      <div class="relative mx-auto flex flex-col items-center gap-3 text-center" style="max-width: var(--max-content-width, 72rem);">
        <!-- Sin barra superior: el logo del espacio va en el título de la portada. -->
        <SiteLogo settings={settings} locale={locale} size="hero" />
        <!-- Con logo y sin título propio, el título sería el nombre del sitio repetido bajo el logo:
             se deja solo para lectores de pantalla y buscadores. -->
        <h1
          class:list={['text-4xl sm:text-[2.625rem] font-bold', settings?.sidebarLogo && !hero.customTitle && 'sr-only']}
          style="color: var(--text-primary); line-height: var(--heading-line-height, 1.2);"
        >
          {hero.title}
        </h1>
        {hero.subtitle && (
          <p class="text-lg max-w-2xl" style="color: var(--text-secondary);">{hero.subtitle}</p>
        )}
      </div>
    </section>
  )}

  {groups.length > 0 ? (
    <>
      <!-- Categorías por sección, como «Logo 3 · Base»: dos columnas y a lo más HOME_MAX tarjetas;
           el resto se abre con «+ N categorías más» para que una sección grande no alargue la portada. -->
      <div class="mx-auto" style="max-width: 56rem;">
        {groups.map(({ section, cats, iconName }) => (
          <section id={section.slug} class="mb-10 first:mt-6 scroll-mt-6">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-3">
              <h2 class="flex items-center gap-2 self-center text-xl font-semibold" style="color: var(--text-primary);">
                {iconName && <span class="flex" style="color: var(--color-brand-500);"><Icon name={iconName} size={20} /></span>}
                {section.name}
              </h2>
              {section.description && (
                <p class="text-sm" style="color: var(--text-secondary);">{section.description}</p>
              )}
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {cats.slice(0, HOME_MAX).map((cat) => (
                <CategoryCard href={`/${locale}/${cat.slug}/${cat.firstSlug}`} name={cat.name} description={cat.description} iconName={cat.iconName} countLabel={ui.articleCount(cat.articles.length)} />
              ))}
            </div>
            {cats.length > HOME_MAX && (
              <details class="home-more mt-3">
                <summary class="text-sm font-medium cursor-pointer" style="color: var(--color-brand-500);">{ui.moreCategories(cats.length - HOME_MAX)} →</summary>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  {cats.slice(HOME_MAX).map((cat) => (
                    <CategoryCard href={`/${locale}/${cat.slug}/${cat.firstSlug}`} name={cat.name} description={cat.description} iconName={cat.iconName} countLabel={ui.articleCount(cat.articles.length)} />
                  ))}
                </div>
              </details>
            )}
          </section>
        ))}
      </div>
    </>
  ) : (
    <div class="flex flex-col items-center justify-center py-20 text-center" style="color: var(--text-muted);">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mb-4 opacity-40" aria-hidden="true">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
      </svg>
      <p class="text-lg font-medium mb-1" style="color: var(--text-secondary);">{ui.emptyTitle}</p>
      <p class="text-sm">{ui.emptyText}</p>
    </div>
  )}
</DocsLayout>
