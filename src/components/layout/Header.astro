---
// Sin barra superior: el logo vive en el título de la portada y arriba del menú lateral en los
// artículos. Aquí quedan solo los controles (enlace externo, idioma y tema) arriba a la derecha, que
// suben con la página, y en celular, en páginas con menú lateral, una fila con ☰ y el logo.
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
import LanguageSwitcher from '@/components/ui/LanguageSwitcher.astro';
import SiteLogo from '@/components/ui/SiteLogo.astro';
import { getUi } from '@/lib/i18n/ui';
import type { DocumentationSpaceSetting } from '@/lib/domain/types';

interface Props {
  settings: DocumentationSpaceSetting | null;
  locale: string;
  supportedLocales: string[];
  /** Solo las páginas con menú lateral lo abren en el celular. */
  showMenuButton?: boolean;
}

const { settings, locale, supportedLocales, showMenuButton = true } = Astro.props;
const ui = getUi(locale);
const ctaText = settings?.headerLinkText;
const ctaUrl = settings?.headerLinkUrl;
---

{showMenuButton && (
  <div class="lg:hidden flex items-center gap-3 h-14 px-4 border-b" style="border-color: var(--border-color);">
    <button
      id="mobile-menu-btn"
      class="p-1.5 rounded-md transition-colors"
      style="color: var(--text-secondary);"
      aria-label={ui.openMenu}
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
    <SiteLogo settings={settings} locale={locale} />
  </div>
)}

<div class="absolute top-0 right-0 z-40 h-14 flex items-center gap-2 px-4">
  <!-- External CTA -->
  {ctaText && ctaUrl && (
    <a
      href={ctaUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-[0.8rem] font-medium border transition-colors"
      style="
        color: var(--text-secondary);
        border-color: var(--border-color);
      "
    >
      {ctaText}
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
        <polyline points="15 3 21 3 21 9"/>
        <line x1="10" y1="14" x2="21" y2="3"/>
      </svg>
    </a>
  )}

  {supportedLocales.length > 1 && (
    <LanguageSwitcher
      currentLocale={locale}
      supportedLocales={supportedLocales}
    />
  )}

  <ThemeToggle locale={locale} />
</div>
