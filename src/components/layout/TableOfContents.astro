---
import { getUi } from '@/lib/i18n/ui';
import type { TocEntry } from '@/lib/domain/types';

interface Props {
  entries: TocEntry[];
  locale: string;
}

const { entries, locale } = Astro.props;
const ui = getUi(locale);
---

<div>
  <p class="text-xs font-semibold uppercase tracking-wider mb-3" style="color: var(--text-secondary);">
    {ui.onThisPage}
  </p>

  <nav aria-label={ui.onThisPage}>
    <ul class="space-y-1">
      {entries.map((entry) => (
        <li>
          <a
            href={`#${entry.id}`}
            data-toc-link
            class="toc-link block text-[0.7rem] py-0.5 transition-colors leading-snug"
            style={`
              color: var(--text-secondary);
              padding-left: ${(entry.level - 2) * 0.75}rem;
            `}
          >
            {entry.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
  const headings = document.querySelectorAll<HTMLElement>('.prose-docs h2, .prose-docs h3, .prose-docs h4, .prose-docs h5, .prose-docs h6');

  const scroller = document.querySelector<HTMLElement>('[data-toc-scroll]');

  // Con un índice más alto que la pantalla, el encabezado activo se mantiene a la vista dentro del
  // índice (sin mover la página).
  function keepVisible(link: HTMLElement) {
    if (!scroller || scroller.scrollHeight <= scroller.clientHeight) return;
    const l = link.getBoundingClientRect();
    const s = scroller.getBoundingClientRect();
    if (l.top < s.top) scroller.scrollTop -= s.top - l.top + 8;
    else if (l.bottom > s.bottom) scroller.scrollTop += l.bottom - s.bottom + 8;
  }

  function setActive(id: string) {
    links.forEach((link) => {
      const isActive = link.getAttribute('href') === `#${id}`;
      if (isActive) {
        link.style.color = 'var(--color-brand-500)';
        link.style.fontWeight = '500';
        keepVisible(link);
      } else {
        link.style.color = 'var(--text-secondary)';
        link.style.fontWeight = '';
      }
    });
  }

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          setActive(entry.target.id);
          break;
        }
      }
    },
    {
      rootMargin: '-60px 0px -80% 0px',
      threshold: 0,
    }
  );

  headings.forEach((h) => {
    if (h.id) observer.observe(h);
  });
</script>
