---
import { getUi } from '@/lib/i18n/ui';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  locale: string;
}

const { items, locale } = Astro.props;
const ui = getUi(locale);
---

<nav aria-label={ui.breadcrumb} class="mb-6">
  <ol class="flex items-center gap-1.5 text-sm flex-wrap" style="color: var(--text-muted);">
    {items.map((item, index) => (
      <li class="flex items-center gap-1.5">
        {index > 0 && (
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        )}
        {item.href ? (
          <a href={item.href} class="font-medium hover:underline transition-colors" style="color: var(--text-secondary);">{item.label}</a>
        ) : (
          <span>{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
