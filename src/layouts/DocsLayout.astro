---
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Sidebar from '@/components/layout/Sidebar.astro';
import SiteLogo from '@/components/ui/SiteLogo.astro';
import TableOfContents from '@/components/layout/TableOfContents.astro';
import Footer from '@/components/layout/Footer.astro';
import type {
  DocumentationSpaceSetting,
  DocumentationSection,
  SidebarCategory,
  TocEntry,
} from '@/lib/domain/types';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  settings: DocumentationSpaceSetting | null;
  sections: DocumentationSection[];
  sidebarCategories: SidebarCategory[];
  activeSectionSlug?: string;
  activeCategorySlug?: string;
  activeArticleSlug?: string;
  toc?: TocEntry[];
  locale: string;
  supportedLocales: string[];
  noindex?: boolean;
  /** La portada no lleva menú lateral: ella misma es el índice. */
  withSidebar?: boolean;
}

const {
  title,
  description,
  ogImage,
  canonicalUrl,
  settings,
  sections,
  sidebarCategories,
  activeSectionSlug,
  activeCategorySlug,
  activeArticleSlug,
  toc = [],
  locale,
  supportedLocales,
  noindex = false,
  withSidebar = true,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  canonicalUrl={canonicalUrl}
  settings={settings}
  locale={locale}
  noindex={noindex}
>
  <div class="relative flex flex-col min-h-screen" style="background-color: var(--bg-primary);">
    <Header
      settings={settings}
      locale={locale}
      supportedLocales={supportedLocales}
      showMenuButton={withSidebar}
    />

    <div class="flex flex-1">
      {withSidebar && (<>
      <!-- Sidebar: el logo va arriba del menú (no hay barra superior) -->
      <aside
        id="sidebar"
        class="sidebar-fixed fixed left-0 top-0 h-full overflow-y-auto hidden lg:block z-30 border-r"
        style="
          width: var(--sidebar-width, 16rem);
          background-color: var(--bg-sidebar);
          border-color: var(--border-color);
        "
      >
        <div class="mx-3 px-2 pt-6 pb-5 border-b" style="border-color: var(--border-color);"><SiteLogo settings={settings} locale={locale} size="sidebar" /></div>
        <Sidebar
          categories={sidebarCategories}
          sections={sections}
          activeSectionSlug={activeSectionSlug}
          activeCategorySlug={activeCategorySlug}
          activeArticleSlug={activeArticleSlug}
          locale={locale}
        />
      </aside>

      <!-- Mobile sidebar overlay -->
      <div
        id="sidebar-overlay"
        class="fixed inset-0 bg-black/50 z-20 hidden lg:hidden"
        aria-hidden="true"
      ></div>

      <!-- Mobile sidebar panel -->
      <aside
        id="mobile-sidebar"
        class="sidebar-fixed fixed left-0 top-0 h-full overflow-y-auto z-30 border-r lg:hidden -translate-x-full transition-transform"
        style="
          width: var(--sidebar-width, 16rem);
          background-color: var(--bg-sidebar);
          border-color: var(--border-color);
          transition-duration: var(--transition-duration, 0.2s);
        "
      >
        <div class="mx-3 px-2 pt-6 pb-5 border-b" style="border-color: var(--border-color);"><SiteLogo settings={settings} locale={locale} size="sidebar" /></div>
        <Sidebar
          categories={sidebarCategories}
          sections={sections}
          activeSectionSlug={activeSectionSlug}
          activeCategorySlug={activeCategorySlug}
          activeArticleSlug={activeArticleSlug}
          locale={locale}
        />
      </aside>
      </>)}

      <!-- Main content -->
      <main
        class="flex-1 min-w-0 flex"
        style={`margin-left: 0;`}
      >
        <div
          class:list={['flex-1 min-w-0', withSidebar && 'lg:ml-[var(--sidebar-width,16rem)]']}
        >
          <!-- Franja de lado a lado sobre el contenido (la usa la portada) -->
          <slot name="hero" />
          <div
            class="flex justify-center"
            style="padding: var(--content-padding-y, 2rem) var(--content-padding-x, 1.5rem);"
          >
            <article
              class="flex-1 min-w-0"
              style="max-width: var(--max-content-width, 72rem);"
            >
              <slot />
            </article>

            <!-- TOC — desktop only. Altura máxima y desplazamiento propio: con muchos encabezados
                 los últimos quedaban fuera de la pantalla y no había forma de llegar a ellos. -->
            {toc.length > 0 && (
              <aside
                data-toc-scroll
                class="hidden xl:block shrink-0 sticky overflow-y-auto overscroll-contain"
                style="
                  width: var(--toc-width, 14rem);
                  top: 1.5rem;
                  height: fit-content;
                  max-height: calc(100vh - 3rem);
                  margin-left: 2rem;
                  margin-top: 2.5rem;
                "
              >
                <TableOfContents entries={toc} locale={locale} />
              </aside>
            )}
          </div>
        </div>
      </main>
    </div>

    <Footer settings={settings} style={withSidebar ? 'margin-left: var(--sidebar-width, 16rem);' : undefined} />
  </div>

  <!-- Mobile sidebar toggle script -->
  <script>
    const overlay = document.getElementById('sidebar-overlay');
    const mobileSidebar = document.getElementById('mobile-sidebar');
    const toggleBtn = document.getElementById('mobile-menu-btn');

    function openSidebar() {
      mobileSidebar?.classList.remove('-translate-x-full');
      overlay?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeSidebar() {
      mobileSidebar?.classList.add('-translate-x-full');
      overlay?.classList.add('hidden');
      document.body.style.overflow = '';
    }

    toggleBtn?.addEventListener('click', openSidebar);
    overlay?.addEventListener('click', closeSidebar);

    // Close on route change (if using view transitions)
    document.addEventListener('astro:before-swap', closeSidebar);
  </script>
</BaseLayout>
